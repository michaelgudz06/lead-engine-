# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---
# Neon Postgres. The app talks to Neon over HTTPS with @neondatabase/serverless.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Claude. The app only ever runs Haiku 5.5 at low effort.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
# Exa: web, news and people search.
EXA_API_KEY=

# --- LinkedIn (one of these) ---
# Unipile, with a separate LinkedIn account connected in the Unipile dashboard.
UNIPILE_API_KEY=
UNIPILE_DSN=https://apiXX.unipile.com:XXXXX
# Optional: pin the connected LinkedIn account. Otherwise the first OK one is used.
UNIPILE_ACCOUNT_ID=
# Apify: fallback LinkedIn profile and posts scraper.
APIFY_TOKEN=

# --- Optional enrichment ---
# Apollo: company data works on the free plan; person match needs a paid plan.
APOLLO_API_KEY=
# Hunter: work email from a LinkedIn handle.
HUNTER_API_KEY=
# OpenRouter: Grok with X search, pinned to the person's handle.
OPENROUTER_API_KEY=
OPENROUTER_X_MODEL=x-ai/grok-4.7
# Abstract: checkpoint inspect (deploy check) for teams on Hugging Face.
ABSTRACT_API_KEY=
# Optional: any free Hugging Face read token. Raises the Hub API rate limit above the
# anonymous 500 requests per 5 minutes per (shared) IP.
HF_TOKEN=

# --- V1 (not wired to a live account yet) ---
HUBSPOT_ACCESS_TOKEN=

# --- Access gate (set both when deployed; leave empty for local dev) ---
# One shared team password. Without it the app is open, so always set it on a public URL.
APP_PASSWORD=
# Any long random string; signs the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=
