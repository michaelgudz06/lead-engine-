# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---
# Neon Postgres. The app talks to Neon over HTTPS with @neondatabase/serverless.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Claude. The app only ever runs Haiku 5.5 at low effort.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
# Exa: web, news and people search.
EXA_API_KEY=

# --- LinkedIn (one of these) ---
# Unipile, with a separate LinkedIn account connected in the Unipile dashboard.
UNIPILE_API_KEY=
UNIPILE_DSN=https://apiXX.unipile.com:XXXXX
# Pin the research LinkedIn account (its Unipile account id). Unpinned, research uses the one
# LinkedIn account in the workspace; with two or more, or once UNIPILE_NETWORK_ACCOUNT_ID is set,
# it refuses to guess and falls back to Apify.
UNIPILE_ACCOUNT_ID=
# Apify: fallback LinkedIn profile and posts scraper.
APIFY_TOKEN=

# --- Optional enrichment ---
# Apollo: company data works on the free plan; person match needs a paid plan.
APOLLO_API_KEY=
# Hunter: work email. The Email Finder (LinkedIn handle, or name plus company), then an address
# built from the company's email pattern: Domain Search (1 credit) and the Email Verifier
# (0.5 credit) when the domain does not accept every address. At most 1.5 credits a lookup.
HUNTER_API_KEY=
# OpenRouter: Grok with X search, pinned to the person's handle.
OPENROUTER_API_KEY=
OPENROUTER_X_MODEL=x-ai/grok-4.7
# Abstract: checkpoint inspect (deploy check) for teams on Hugging Face.
ABSTRACT_API_KEY=
# Optional: any free Hugging Face read token. Raises the Hub API rate limit above the
# anonymous 500 requests per 5 minutes per (shared) IP.
HF_TOKEN=

# --- HubSpot (built against HubSpot's API docs; not yet tested against a live account) ---
# A private app's access token. Push needs the contacts, companies and deals read and write
# scopes; import needs crm.objects.contacts.read (add crm.schemas.contacts.read to find LinkedIn
# URLs in custom properties). Import is refused on Vercel until APP_PASSWORD is set, because
# the list holds your CRM contacts.
HUBSPOT_ACCESS_TOKEN=

# --- Warm paths (optional): people who could introduce you to a lead ---
# twitterapi.io key: compares your X follows with a lead's ($1 = 100,000 credits). Off until set.
TWITTERAPI_IO_KEY=
# Your own LinkedIn's Unipile account id, for warm paths only. Off until set. Pin UNIPILE_ACCOUNT_ID first.
UNIPILE_NETWORK_ACCOUNT_ID=
# Checks a day on your own LinkedIn account, at least 2 minutes apart (default 10; 0 pauses them).
WARM_PATH_LINKEDIN_CHECKS_PER_DAY=
# Dollars of twitterapi.io credits a day for X, cents allowed such as 0.5 (default 1; 0 pauses X checks).
WARM_PATH_X_USD_PER_DAY=

# --- Access gate (set both when deployed; leave empty for local dev) ---
# One shared team password. Without it the app is open, so always set it on a public URL.
APP_PASSWORD=
# Any long random string; signs the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=
# On Vercel the app refuses all traffic while APP_PASSWORD is unset. Set this to 1 to run it
# open on purpose (anyone with the URL can see leads, the people shown in their warm paths included,
# and start research; runs are capped at 20 an hour).
ALLOW_OPEN_ACCESS=
# Optional: research and steer runs allowed per rolling hour and per rolling 24 hours, across
# all leads (defaults 20 and 25). A research run costs about $0.15 and reads LinkedIn 4 times.
# Set either to 0 to pause all runs (new leads are still saved, without a run).
RUN_LIMIT_PER_HOUR=
RUN_LIMIT_PER_DAY=
# Optional: new leads that imports may add per rolling 24 hours, across the app (default 2000).
# 0 pauses imports.
IMPORT_LIMIT_PER_DAY=
# Optional: Hunter credits that email lookups may spend per rolling 24 hours, across the app
# (default 10; the free plan has 50 a month). "Find email" and research share it. 0 pauses lookups.
HUNTER_CREDITS_PER_DAY=
# The Usage tab (/usage) follows the same rules as every page: behind the team password when
# it is set, open to anyone with the URL when ALLOW_OPEN_ACCESS=1.

# --- Product analytics (PostHog) ---
# Project API key (starts with phc_; it is public by design) and region host.
# Leave the key empty to turn analytics off. NEXT_PUBLIC_ values are fixed at build time.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
